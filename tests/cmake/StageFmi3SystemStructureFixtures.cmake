if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT_DIR OR
   NOT DEFINED FEEDTHROUGH_FMU OR NOT DEFINED STATE_SPACE_FMU OR
   NOT DEFINED STAIR_FMU OR NOT DEFINED CLOCKED_FMU OR
   NOT DEFINED SCHEDULED_FMU OR NOT DEFINED POWER_BOND_FMU OR
   NOT DEFINED FMI2_VECTOR_FMU OR NOT DEFINED FMI2_MIXED_TYPES_FMU)
    message(FATAL_ERROR
        "SOURCE_DIR, OUTPUT_DIR, FEEDTHROUGH_FMU, STATE_SPACE_FMU, "
        "STAIR_FMU, CLOCKED_FMU, SCHEDULED_FMU, and POWER_BOND_FMU "
        "and FMI2_VECTOR_FMU and FMI2_MIXED_TYPES_FMU are required")
endif()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(COPY "${SOURCE_DIR}/" DESTINATION "${OUTPUT_DIR}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/fmus")
file(COPY_FILE
    "${FEEDTHROUGH_FMU}"
    "${OUTPUT_DIR}/fmus/Feedthrough.fmu"
    ONLY_IF_DIFFERENT)
file(COPY_FILE
    "${STATE_SPACE_FMU}"
    "${OUTPUT_DIR}/fmus/StateSpace.fmu"
    ONLY_IF_DIFFERENT)
file(COPY_FILE
    "${STAIR_FMU}"
    "${OUTPUT_DIR}/fmus/Stair.fmu"
    ONLY_IF_DIFFERENT)
file(COPY_FILE
    "${CLOCKED_FMU}"
    "${OUTPUT_DIR}/fmus/ClockedCoSimulation.fmu"
    ONLY_IF_DIFFERENT)
file(COPY_FILE
    "${SCHEDULED_FMU}"
    "${OUTPUT_DIR}/fmus/Clocks.fmu"
    ONLY_IF_DIFFERENT)
file(COPY_FILE
    "${POWER_BOND_FMU}"
    "${OUTPUT_DIR}/fmus/PowerBond.fmu"
    ONLY_IF_DIFFERENT)
file(COPY_FILE
    "${FMI2_VECTOR_FMU}"
    "${OUTPUT_DIR}/fmus/vector.fmu"
    ONLY_IF_DIFFERENT)
file(COPY_FILE
    "${FMI2_MIXED_TYPES_FMU}"
    "${OUTPUT_DIR}/fmus/MixedTypes.fmu"
    ONLY_IF_DIFFERENT)
